      "to": 6.69,
      "lines": [
        "Você quer muito uma coisa."
      ]
    },
    {
      "from": 7.125,
      "to": 9.495,
      "lines": [
        "Pensa nela antes de dormir."
      ]
    },
    {
      "from": 9.505,
      "to": 11.23,
      "lines": [
        "Trabalha por ela."
      ]
    },
    {
      "from": 11.285,
      "to": 14.49,
      "lines": [
        "E quando finalmente consegue,",
        "a alegria dura uns dias."
      ]
    },
    {
      "from": 14.585,
      "to": 18.05,
      "lines": [
        "Depois aquilo vira só mais",
        "uma coisa que você tem."
      ]
    },
    {
      "from": 21.171,
      "to": 24.341,
      "lines": [
        "Um homem percebeu isso há duzentos anos."
      ]
    },
    {
      "from": 24.351,
      "to": 28.841,
      "lines": [
        "Ele se chamava Arthur Schopenhauer,",
        "e chegou a uma conclusão que até hoje"
      ]
    },
    {
      "from": 28.851,
      "to": 30.456,
      "lines": [
        "incomoda muita gente."
      ]
    },
    {
      "from": 31.139,
      "to": 36.329,
      "lines": [
        "Para ele, a vida oscila como um pêndulo,",
        "para lá e para cá, entre a dor e o"
      ]
    },
    {
      "from": 36.339,
      "to": 37.379,
      "lines": [
        "tédio."
      ]
    },
    {
      "from": 37.979,
      "to": 42.949,
      "lines": [
        "Quando você deseja algo e não tem, sofre."
      ]
    },
    {
      "from": 42.959,
      "to": 46.284,
      "lines": [
        "É a dor da falta."
      ]
    },
    {
      "from": 46.359,
      "to": 51.884,
      "lines": [
        "Quando finalmente consegue, o desejo",
        "some, e no lugar dele aparece um vazio."
      ]
    },
    {
      "from": 52.039,
      "to": 53.249,
      "lines": [
        "É o tédio."
      ]
    },
    {
      "from": 53.259,
      "to": 56.529,
      "lines": [
        "E para fugir do tédio, você",
        "inventa um desejo novo."
      ]
    },
    {
      "from": 56.539,
      "to": 59.644,
      "lines": [
        "E o pêndulo volta a balançar."
      ]
    },
    {
      "from": 60.087,
      "to": 62.072,
      "lines": [
        "Hoje esse pêndulo tem nome."
      ]
    },
    {
      "from": 62.507,
      "to": 63.752,
      "lines": [
        "Ele mora no celular."
      ]
    },
    {
      "from": 63.867,
      "to": 67.557,
      "lines": [
        "Cada notificação é um desejo",
        "pequeno, cada rolagem é uma"
      ]
    },
    {
      "from": 67.567,
      "to": 69.477,
      "lines": [
        "fuga pequena do tédio."
      ]
    },
    {
      "from": 69.487,
      "to": 74.072,
      "lines": [
        "A gente nunca esteve tão ocupado,",
        "e nunca esteve tão vazio."
      ]
    },
    {
      "from": 74.563,
      "to": 77.633,
      "lines": [
        "Schopenhauer não prometia uma saída fácil."
      ]
    },
    {
      "from": 77.643,
      "to": 81.453,
      "lines": [
        "Mas dizia que entender o pêndulo",
        "já te tira de dentro dele."
      ]
    },
    {
      "from": 81.463,
      "to": 86.473,
      "lines": [
        "Então talvez a pergunta não seja",
        "o que você ainda precisa conseguir."
      ]
    },
    {
      "from": 86.483,
      "to": 90.713,
      "lines": [
        "Talvez seja outra: quanto da sua vida",
        "está passando no caminho entre um"
      ]
    },
    {
      "from": 90.723,
      "to": 92.348,
      "lines": [
        "desejo e o próximo?"
      ]
    }
  ],
  "total": 94.498
}
